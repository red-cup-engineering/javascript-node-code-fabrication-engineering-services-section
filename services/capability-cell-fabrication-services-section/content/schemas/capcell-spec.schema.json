{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-cup-engineering.github.io/capability-cell-fabrication-services-section/schemas/capcell-spec.schema.json",
  "title": "Capability Cell specification — compatible v1 and source-pinned v2 profiles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "identity",
    "capability"
  ],
  "properties": {
    "profile": {
      "enum": [
        "org.red-cup-engineering.capcell.v1",
        "org.red-cup-engineering.capcell.v2"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "account"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "pattern": "^urn:"
        },
        "account": {
          "type": "string",
          "pattern": "^eip155:[0-9]+:0x[0-9a-f]{40}$"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "law",
        "kernel",
        "inputSchema",
        "outputSchema",
        "refusalSchema"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "law": {
          "type": "string",
          "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        },
        "kernel": {
          "type": "string",
          "pattern": "^\\./(?!.*\\.\\.)"
        },
        "inputSchema": {
          "type": "string",
          "pattern": "^\\./(?!.*\\.\\.)"
        },
        "outputSchema": {
          "type": "string",
          "pattern": "^\\./(?!.*\\.\\.)"
        },
        "refusalSchema": {
          "type": "string",
          "pattern": "^\\./(?!.*\\.\\.)"
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "semanticId",
          "authority"
        ],
        "properties": {
          "package": {
            "type": "string",
            "minLength": 1
          },
          "semanticId": {
            "type": "string",
            "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
          },
          "authority": {
            "const": "none"
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sas",
        "hld",
        "lld"
      ],
      "properties": {
        "sas": {
          "$ref": "#/$defs/sourcePin"
        },
        "hld": {
          "$ref": "#/$defs/sourcePin"
        },
        "lld": {
          "$ref": "#/$defs/sourcePin"
        }
      }
    }
  },
  "description": "One existing specification carrier. V1 excludes lineage. V2 requires exactly three SHA-256-pinned SAS/HLD/LLD sources; source byte readback and distinct pin identities are enforced by the runtime, not claimed by JSON Schema.",
  "$defs": {
    "sourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "revision",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https:\\/\\/[^\\s/?#@]+(?:[/?][^\\s#]*)?$",
          "description": "Absolute canonical HTTPS URL. Credentials/fragment rejected; @ is permitted in path/query, not userinfo; runtime enforces canonical URL serialization."
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!(?:[mM][aA][iI][nN]|[mM][aA][sS][tT][eE][rR]|[lL][aA][tT][eE][sS][tT]|[hH][eE][aA][dD])$)\\S+$",
          "description": "Explicit source-native immutable revision. A nonfloating-looking string alone does not prove immutability."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hex of exact bytes, never the Git blob SHA."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "org.red-cup-engineering.capcell.v2"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "required": [
          "lineage"
        ]
      },
      "else": {
        "not": {
          "required": [
            "lineage"
          ]
        }
      }
    }
  ]
}
