{
  "name": "@red-cup-engineering/cell-identity-verification-service",
  "version": "0.1.5",
  "private": false,
  "type": "module",
  "description": "Independently verifies that public capability-cell faces bind to one RMN manifest identity, returning bound, absent, or invalid for every face.",
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/verify-cell-identity.mjs"
    }
  },
  "bin": {
    "verify-cell-identity": "./scripts/verify-cell-identity.mjs"
  },
  "files": [
    "scripts/",
    "content/",
    "src/",
    "types/"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/relation-model-notation-cbor-codec": "0.1.1",
    "@red-cup-engineering/relation-model-notation-runtime": "0.10.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/cell-identity-verification-service.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
